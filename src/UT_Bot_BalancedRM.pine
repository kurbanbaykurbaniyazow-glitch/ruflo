//@version=6
strategy(
    title                  = "UT Bot + Risk Management",
    overlay                = true,
    default_qty_type       = strategy.fixed,
    default_qty_value      = 1,
    initial_capital        = 10000,
    currency               = currency.USD,
    commission_type        = strategy.commission.percent,
    commission_value       = 0.05,
    process_orders_on_close = true,
    max_labels_count       = 500
)

// ══════════════════════════════════════════════════════════════════
//  UT BOT CORE — original signal logic, UNCHANGED
// ══════════════════════════════════════════════════════════════════
c = input.int(10,     title = "ATR Period")
h = input.bool(false, title = "Heikin Ashi Candles")

// Key Value per timeframe — auto-selected based on active chart TF
a_15m = input.int(1, title = "15M",       minval = 1, group = "Key Value (per TF)", inline = "r1")
a_30m = input.int(1, title = "30M",       minval = 1, group = "Key Value (per TF)", inline = "r1")
a_1h  = input.int(1, title = "1H",        minval = 1, group = "Key Value (per TF)", inline = "r2")
a_4h  = input.int(2, title = "4H",        minval = 1, group = "Key Value (per TF)", inline = "r2")
a_1d  = input.int(3, title = "1D",        minval = 1, group = "Key Value (per TF)", inline = "r3")
a_def = input.int(1, title = "Other TFs", minval = 1, group = "Key Value (per TF)", inline = "r3")

int tf_secs = timeframe.in_seconds()
int a = if tf_secs <= 900
    a_15m
else if tf_secs <= 1800
    a_30m
else if tf_secs <= 3600
    a_1h
else if tf_secs <= 14400
    a_4h
else if tf_secs <= 86400
    a_1d
else
    a_def

xATR  = ta.atr(c)
nLoss = a * xATR
src   = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close,
             lookahead = barmerge.lookahead_off) : close

var float xATRTrailingStop = 0.0
float prevTS = nz(xATRTrailingStop[1], 0.0)

float newTS = if src > prevTS and src[1] > prevTS
    math.max(prevTS, src - nLoss)
else if src < prevTS and src[1] < prevTS
    math.min(prevTS, src + nLoss)
else if src > prevTS
    src - nLoss
else
    src + nLoss

xATRTrailingStop := na(newTS) ? prevTS : newTS

var int pos = 0
pos := if src[1] < prevTS and src > prevTS
    1
else if src[1] > prevTS and src < prevTS
    -1
else
    nz(pos[1], 0)

above = ta.crossover(src, xATRTrailingStop)
below = ta.crossover(xATRTrailingStop, src)

buy  = src > xATRTrailingStop and above
sell = src < xATRTrailingStop and below

// ══════════════════════════════════════════════════════════════════
//  PRICE MEMORY TREND CORE  (© Uptrick, CC BY-SA 4.0)
//  Computed here (before entries) so pmt_trend is available as a
//  filter. Visual output rendered after trade management.
// ══════════════════════════════════════════════════════════════════
pmt_grp       = "Price Memory Trend"
pmt_memStr    = input.float(0.12, "Memory Strength",  step = 0.01, group = pmt_grp)
pmt_memDec    = input.float(0.96, "Memory Decay",     step = 0.01, group = pmt_grp)
pmt_devLen    = input.int(34,     "Deviation Length", minval = 5,  group = pmt_grp)
pmt_bandMul   = input.float(1.6,  "Band Multiplier",  step = 0.1,  group = pmt_grp)
pmt_palette   = input.string("Default", "Color Palette",
     options = ["Default","Emerald vs Red","Neon Cyan vs Magenta",
                "Electric Lime vs Crimson","Ice Blue vs Inferno","Gold vs Violet"],
     group = pmt_grp)
pmt_showBands = input.bool(true,   "Show Bands",      group = pmt_grp)
pmt_look      = input.string("Bands", "Look",
     options = ["Bands","Trail","Intense"], group = pmt_grp)
pmt_showTbl   = input.bool(true,   "Show PMT Table",  group = pmt_grp)
pmt_tblPos    = input.string("Bottom Right", "Table Position",
     options = ["Top Left","Top Right","Bottom Left","Bottom Right"], group = pmt_grp)
pmt_tblSzStr  = input.string("Small", "Text Size",
     options = ["Tiny","Small","Normal","Large"], group = pmt_grp)
usePMTFilter  = input.bool(true, "Use PMT as entry filter", group = pmt_grp)

color pmt_bull =
     pmt_palette == "Default"                  ? #00ffea :
     pmt_palette == "Emerald vs Red"           ? color.rgb(0, 255, 170) :
     pmt_palette == "Neon Cyan vs Magenta"     ? color.rgb(0, 255, 255) :
     pmt_palette == "Electric Lime vs Crimson" ? color.rgb(170, 255, 0) :
     pmt_palette == "Ice Blue vs Inferno"      ? color.rgb(120, 200, 255) :
                                                 color.rgb(255, 210, 80)
color pmt_bear =
     pmt_palette == "Default"                  ? #ff00ff :
     pmt_palette == "Emerald vs Red"           ? color.rgb(255, 60, 60) :
     pmt_palette == "Neon Cyan vs Magenta"     ? color.rgb(255, 0, 200) :
     pmt_palette == "Electric Lime vs Crimson" ? color.rgb(200, 0, 40) :
     pmt_palette == "Ice Blue vs Inferno"      ? color.rgb(255, 80, 0) :
                                                 color.rgb(150, 60, 255)
color pmt_neutral = #85858559

var float pmt_mem = close
pmt_mem := pmt_mem + (close - pmt_mem) * pmt_memStr
pmt_mem := pmt_mem * pmt_memDec + close * (1 - pmt_memDec)
float pmt_base   = pmt_mem
float pmt_dev    = math.abs(close - pmt_base)
float pmt_avgDev = ta.ema(pmt_dev, pmt_devLen)
float pmt_upper  = pmt_base + pmt_avgDev * pmt_bandMul
float pmt_lower  = pmt_base - pmt_avgDev * pmt_bandMul

bool pmt_bullCond = ta.crossover(close, pmt_upper)
bool pmt_bearCond = ta.crossunder(close, pmt_lower)
var int pmt_trend = 0
bool pmt_newBull  = pmt_bullCond and pmt_trend != 1
bool pmt_newBear  = pmt_bearCond and pmt_trend != -1
pmt_trend := pmt_newBull ? 1 : pmt_newBear ? -1 : nz(pmt_trend[1], 0)

// Metrics computed every bar for correct table history
float pmt_bwSeries  = pmt_upper - pmt_lower
int   pmt_barsSince = ta.barssince(pmt_newBull or pmt_newBear)
bool  pmt_isTight   = pmt_bwSeries < ta.ema(pmt_bwSeries, pmt_devLen)
float pmt_stretch   = pmt_avgDev != 0 ? (close - pmt_base) / pmt_avgDev : 0.0
float pmt_absStr    = math.abs(pmt_stretch)
float pmt_mSlope    = pmt_base - pmt_base[1]
float pmt_mAccel    = pmt_mSlope - pmt_mSlope[1]

// Entry filter: Long only when PMT is bullish, Short only when bearish
bool pmt_long_ok  = not usePMTFilter or pmt_trend == 1
bool pmt_short_ok = not usePMTFilter or pmt_trend == -1

// ══════════════════════════════════════════════════════════════════
//  MULTI-TIMEFRAME FILTER
//  Each TF checks UT Bot direction on the higher TF (HTF) and the
//  lower TF (LTF) using the corresponding key values.
//  Example on 4H: HTF = 1D (key a_1d), LTF = 1H (key a_1h).
// ══════════════════════════════════════════════════════════════════
useMTF = input.bool(true, title = "Enable MTF filter (HTF + LTF)", group = "Multi-TF Filter")

f_ut_dir(int a_key, int atr_p) =>
    nL_ = a_key * ta.atr(atr_p)
    var float ts_ = 0.0
    p_  = nz(ts_[1])
    n_  = if close > p_ and close[1] > p_
        math.max(p_, close - nL_)
    else if close < p_ and close[1] < p_
        math.min(p_, close + nL_)
    else if close > p_
        close - nL_
    else
        close + nL_
    ts_ := na(n_) ? p_ : n_
    [close > ts_, close < ts_]

string htf = if tf_secs <= 1800
    "60"
else if tf_secs <= 3600
    "240"
else if tf_secs <= 14400
    "D"
else if tf_secs <= 86400
    "W"
else
    "M"

string ltf = if tf_secs <= 900
    "5"
else if tf_secs <= 1800
    "15"
else if tf_secs <= 3600
    "15"
else if tf_secs <= 14400
    "60"
else if tf_secs <= 86400
    "240"
else
    "D"

int a_htf = if tf_secs <= 3600
    a_4h
else if tf_secs <= 14400
    a_1d
else
    a_def

int a_ltf = if tf_secs <= 3600
    a_15m
else if tf_secs <= 14400
    a_1h
else if tf_secs <= 86400
    a_4h
else
    a_def

[htf_bull, htf_bear] = request.security(syminfo.tickerid, htf, f_ut_dir(a_htf, c), lookahead = barmerge.lookahead_off)
[ltf_bull, ltf_bear] = request.security(syminfo.tickerid, ltf, f_ut_dir(a_ltf, c), lookahead = barmerge.lookahead_off)

bool mtf_long  = not useMTF or (htf_bull and ltf_bull)
bool mtf_short = not useMTF or (htf_bear and ltf_bear)

// ══════════════════════════════════════════════════════════════════
//  RISK MANAGEMENT INPUT
// ══════════════════════════════════════════════════════════════════
riskPct = input.float(1.0, title = "Risk per trade (%)", step = 0.1, group = "Risk Management")
float slMult = 0.5

// ══════════════════════════════════════════════════════════════════
//  POSITION SIZING
// ══════════════════════════════════════════════════════════════════
riskAmt = strategy.equity * riskPct / 100.0
rawQty  = nLoss > 0 ? riskAmt / (nLoss * slMult) : na
maxQty  = close > 0 ? strategy.equity / close : na
qty     = not na(rawQty) and not na(maxQty) ? math.min(rawQty, maxQty) : na

// ══════════════════════════════════════════════════════════════════
//  POSITION STATE
// ══════════════════════════════════════════════════════════════════
var float entryP   = na
var float curSL    = na
var float stopDist = na
var bool  trailOn  = false

bool entryLong  = buy  and not na(qty) and mtf_long  and pmt_long_ok
bool entryShort = sell and not na(qty) and mtf_short and pmt_short_ok
bool noNewEntry = not entryLong and not entryShort

// ══════════════════════════════════════════════════════════════════
//  ENTRIES
// ══════════════════════════════════════════════════════════════════
if entryLong
    entryP   := close
    stopDist := nLoss * slMult
    curSL    := close - stopDist
    trailOn  := false
    strategy.entry("Long", strategy.long, qty = qty)
    strategy.exit("Long Exit", "Long", stop = curSL, comment = "SL")
    alert("UT Bot LONG @ " + str.tostring(close), alert.freq_once_per_bar)

if entryShort
    entryP   := close
    stopDist := nLoss * slMult
    curSL    := close + stopDist
    trailOn  := false
    strategy.entry("Short", strategy.short, qty = qty)
    strategy.exit("Short Exit", "Short", stop = curSL, comment = "SL")
    alert("UT Bot SHORT @ " + str.tostring(close), alert.freq_once_per_bar)

// ══════════════════════════════════════════════════════════════════
//  IN-TRADE MANAGEMENT
//  LONG: SL flat → at +0.5R lock to +0.25R → trail at 0.5 ATR
//  SHORT: mirror
// ══════════════════════════════════════════════════════════════════
if noNewEntry
    if strategy.position_size > 0
        if not trailOn and high >= entryP + stopDist
            trailOn := true
            curSL   := entryP + stopDist * slMult
        if trailOn
            curSL := math.max(curSL, close - stopDist)
        strategy.exit("Long Exit", "Long", stop = curSL, comment = "SL")

    if strategy.position_size < 0
        if not trailOn and low <= entryP - stopDist
            trailOn := true
            curSL   := entryP - stopDist * slMult
        if trailOn
            curSL := math.min(curSL, close + stopDist)
        strategy.exit("Short Exit", "Short", stop = curSL, comment = "SL")

// Reset on clean close
if strategy.position_size == 0 and strategy.position_size[1] != 0 and noNewEntry
    entryP   := na
    curSL    := na
    stopDist := na
    trailOn  := false

// ══════════════════════════════════════════════════════════════════
//  PRICE MEMORY TREND VISUALS  (© Uptrick, CC BY-SA 4.0)
// ══════════════════════════════════════════════════════════════════
color pmt_cc = pmt_trend == 1 ? pmt_bull : pmt_trend == -1 ? pmt_bear : pmt_neutral
plotcandle(open, high, low, close, color = pmt_cc, wickcolor = pmt_cc, bordercolor = pmt_cc)

pmt_p1 = plot(pmt_showBands ? pmt_upper : na, "PMT Upper",
     color = pmt_trend == -1 ? color.new(pmt_bear, 40) : color.new(pmt_bear, 100),
     linewidth = pmt_look != "Trail" ? 1 : 3)
pmt_p2 = plot(pmt_showBands ? pmt_lower : na, "PMT Lower",
     color = pmt_trend == 1  ? color.new(pmt_bull, 40) : color.new(pmt_bull, 100),
     linewidth = pmt_look != "Trail" ? 1 : 3)
pmt_p3 = plot(pmt_showBands and pmt_look != "Trail" ? pmt_upper + ta.atr(14) : na, "PMT Outer Upper",
     color = pmt_trend == -1 ? color.new(pmt_bear, 40) : color.new(pmt_bear, 100))
pmt_p4 = plot(pmt_showBands and pmt_look != "Trail" ? pmt_lower - ta.atr(14) : na, "PMT Outer Lower",
     color = pmt_trend == 1  ? color.new(pmt_bull, 40) : color.new(pmt_bull, 100))

fill(pmt_p1, pmt_p3, pmt_upper + ta.atr(14), pmt_upper,
     pmt_trend == -1 ? color.new(pmt_bear, 70) : na,
     pmt_trend == -1 ? color.new(pmt_bear, 70) : na)
fill(pmt_p2, pmt_p4, pmt_lower - ta.atr(14), pmt_lower,
     pmt_trend == 1 ? color.new(pmt_bull, 70) : na,
     pmt_trend == 1 ? color.new(pmt_bull, 70) : na)

pmt_cp1 = plot(close, color = #363a4500)
pmt_cp2 = plot(close, color = #363a4500)
fill(pmt_p2, pmt_cp1, close, pmt_lower,
     pmt_trend == 1 and pmt_look == "Intense" ? color.new(pmt_bull, 100) : na,
     pmt_trend == 1 and pmt_look == "Intense" ? color.new(pmt_bull, 80)  : na)
fill(pmt_p1, pmt_cp2, pmt_upper, close,
     pmt_trend == -1 and pmt_look == "Intense" ? color.new(pmt_bear, 70)  : na,
     pmt_trend == -1 and pmt_look == "Intense" ? color.new(pmt_bull, 100) : na)

pmt_off = pmt_avgDev * 0.25
if pmt_newBull
    label.new(bar_index, pmt_lower - pmt_off, "Up",
         style = label.style_label_up, size = size.normal,
         color = pmt_bull, textcolor = color.black, force_overlay = true)
if pmt_newBear
    label.new(bar_index, pmt_upper + pmt_off, "Down",
         style = label.style_label_down, size = size.normal,
         color = pmt_bear, textcolor = color.white, force_overlay = true)

alertcondition(pmt_newBull, "PMT Bull", "Price Memory Trend: BULL")
alertcondition(pmt_newBear, "PMT Bear", "Price Memory Trend: BEAR")

pmt_tPos = pmt_tblPos == "Top Left"    ? position.top_left    :
           pmt_tblPos == "Top Right"   ? position.top_right   :
           pmt_tblPos == "Bottom Left" ? position.bottom_left :
                                         position.bottom_right
pmt_tSz  = pmt_tblSzStr == "Tiny"   ? size.tiny   :
           pmt_tblSzStr == "Small"  ? size.small  :
           pmt_tblSzStr == "Normal" ? size.normal :
                                      size.large

var table pmt_tbl = table.new(pmt_tPos, 2, 12,
     frame_color = color.new(color.white, 70), frame_width = 1,
     bgcolor = #000000, border_color = #5b5b5b, border_width = 1)

if barstate.islast and pmt_showTbl
    float pmt_bwPct  = pmt_base != 0 ? pmt_bwSeries / pmt_base * 100 : 0.0
    float pmt_posInB = pmt_bwSeries != 0 ? (close - pmt_lower) / pmt_bwSeries : 0.5
    float pmt_posPct = math.min(math.max(pmt_posInB * 100, 0), 100)
    color pmt_tCol   = pmt_trend == 1 ? pmt_bull : pmt_trend == -1 ? pmt_bear : color.gray
    color pmt_sCol   = pmt_absStr >= 1.2 ? pmt_tCol : pmt_absStr >= 0.8 ? color.new(pmt_tCol, 30) : color.gray

    table.cell(pmt_tbl, 0, 0, "PMT", text_color = color.white, text_size = pmt_tSz, bgcolor = color.new(color.black, 70))
    table.merge_cells(pmt_tbl, 0, 0, 1, 0)
    table.cell(pmt_tbl, 0, 1, "Trend",       text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 1, pmt_trend == 1 ? "Bull" : pmt_trend == -1 ? "Bear" : "-", text_color = pmt_tCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 2, "Trend Age",   text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 2, str.tostring(pmt_barsSince) + " bars", text_color = pmt_tCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 3, "Stretch",     text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 3, str.tostring(pmt_stretch, "#.##") + "x", text_color = pmt_sCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 4, "Band State",  text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 4, close > pmt_upper ? "Hot" : close < pmt_lower ? "Cool" : "Calm", text_color = pmt_tCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 5, "Band Width",  text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 5, str.tostring(pmt_bwPct, "#.##") + "%", text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 6, "Band Pos",    text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 6, str.tostring(pmt_posPct, "#") + "%", text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 7, "Compression", text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 7, pmt_isTight ? "Tight" : "Wide", text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 8, "Rev Risk",    text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 8, pmt_absStr > 1.5 ? "Extreme" : pmt_absStr > 1.0 ? "Elevated" : "Neutral", text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0, 9, "Mem Slope",   text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1, 9, str.tostring(pmt_mSlope, format.mintick), text_color = pmt_tCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0,10, "Mem Accel",   text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1,10, str.tostring(pmt_mAccel, format.mintick), text_color = pmt_tCol, text_size = pmt_tSz)
    table.cell(pmt_tbl, 0,11, "Confidence",  text_color = color.white, text_size = pmt_tSz)
    table.cell(pmt_tbl, 1,11, pmt_absStr > 1.5 ? "High" : pmt_absStr > 1.2 ? "Good" : pmt_absStr > 0.8 ? "Mid" : pmt_absStr > 0.4 ? "Low" : "Min", text_color = pmt_tCol, text_size = pmt_tSz)

// ══════════════════════════════════════════════════════════════════
//  UT BOT VISUALS
// ══════════════════════════════════════════════════════════════════
xcolor = pos == -1 ? color.red : pos == 1 ? color.green : color.blue
plot(xATRTrailingStop, color = xcolor, linewidth = 2, title = "ATR Trailing Stop")

plotshape(entryLong  and barstate.isconfirmed, title = "Buy",  text = "Buy",  style = shape.labelup,   location = location.belowbar, color = color.green, textcolor = color.white, size = size.small)
plotshape(entryShort and barstate.isconfirmed, title = "Sell", text = "Sell", style = shape.labeldown, location = location.abovebar, color = color.red,   textcolor = color.white, size = size.small)

barcolor(src > xATRTrailingStop ? color.green : na)
barcolor(src < xATRTrailingStop ? color.red   : na)

bool  inPos   = strategy.position_size != 0
color slColor = trailOn ? color.lime : color.red
plot(inPos ? curSL : na, style = plot.style_linebr, color = slColor, linewidth = 1, title = "Stop Loss")

// ══════════════════════════════════════════════════════════════════
//  PERFORMANCE DASHBOARD
// ══════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 70), border_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "UT BOT + RM", bgcolor = color.new(color.blue, 50), text_color = color.white, text_size = size.normal)
    table.cell(dash, 1, 0, "",            bgcolor = color.new(color.blue, 50), text_color = color.white, text_size = size.normal)

    table.cell(dash, 0, 1, "Equity",        text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 1, "$" + str.tostring(strategy.equity, "#.0"), text_color = color.yellow, text_size = size.small)

    table.cell(dash, 0, 2, "Net P&L",       text_color = color.silver, text_size = size.small)
    float npnl   = strategy.netprofit
    color npnlCl = npnl >= 0 ? color.lime : color.red
    table.cell(dash, 1, 2, (npnl >= 0 ? "+" : "") + "$" + str.tostring(npnl, "#.0"), text_color = npnlCl, text_size = size.small)

    table.cell(dash, 0, 3, "Win Rate",      text_color = color.silver, text_size = size.small)
    float wr = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0.0
    table.cell(dash, 1, 3, str.tostring(wr, "#.0") + "%", text_color = color.yellow, text_size = size.small)

    table.cell(dash, 0, 4, "Profit Factor", text_color = color.silver, text_size = size.small)
    float gl  = strategy.grossloss != 0 ? math.abs(strategy.grossloss) : 1.0
    float pf  = strategy.grossprofit / gl
    color pfCl = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.orange : color.red
    table.cell(dash, 1, 4, str.tostring(pf, "#.00"), text_color = pfCl, text_size = size.small)

    table.cell(dash, 0, 5, "Max DD",        text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(strategy.max_drawdown_percent, "#.1") + "%", text_color = color.red, text_size = size.small)

    table.cell(dash, 0, 6, "Trades",        text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(strategy.closedtrades), text_color = color.white, text_size = size.small)
